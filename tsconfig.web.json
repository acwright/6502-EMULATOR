{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/core/**/*",
    "src/debug/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@core/*": ["src/core/*"],
      "@debug/*": ["src/debug/*"],
      "@shared/*": ["src/shared/*"]
    },
    // Same reasoning as tsconfig.node.json: src/core and src/debug are shared
    // with tsconfig.core.json (Jest, the CLI build), which does not enable
    // these — an IO card's tick(frequency) or reset(coldStart) routinely
    // ignores the argument, matching the IO interface rather than leaving dead
    // code. The renderer reaching those directories should not retroactively
    // demand an unrelated cleanup of code that already typechecks correctly
    // under its own project.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
