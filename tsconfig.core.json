{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@debug/*": ["src/debug/*"]
    }
  },
  "include": ["src/core/**/*", "src/debug/**/*", "src/tests/**/*"]
}
